{
  "family": "flask-ecr-demo-task",
  "executionRoleArn": "arn:aws:iam::255945442255:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "flask-app",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/flask-ecr-demo:{{IMAGE_TAG}}",
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}
